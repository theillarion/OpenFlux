# Copy to .env (gitignored) or export inline. All optional except the
# credentials of whichever transport you run.

# Transport channel: yandex (legacy docs editor) | vyandex (new volga editor)
#                    | oneme (MAX) | cupsonline | mailru
TRANSPORT=yandex

# yandex / vyandex / mailru: public document URL shared by client and exit node.
# cupsonline: the exit node prints a base64 room list in its logs; the client
#             must run with DOC_URL set to that list.
DOC_URL=

# oneme: MAX Web token + the *other* side's user id (client dials the exit node's uid).
MAX_TOKEN=
MAX_UID=

# Client only: SOCKS5 is published on the host as 127.0.0.1:<SOCKS5_PORT>;
# the container listens on the same port. Change it if 1080 is taken.
SOCKS5_PORT=1080

# Exit node only: l4 (gVisor proxy, works everywhere) | l3 (raw SNAT/DNAT,
# fastest, Linux only; compose already grants the needed caps).
MODE=l4

# Wire codec: batched (default, zstd+coalescing) | legacy (old per-packet LZ4).
# Client and exit node must use the same one.
CODEC=

# Optional AES-256-GCM shared secret. Both ends must use the same value;
# empty = unencrypted. Passed to the container as env, never mounted as a file.
ENCRYPTION_KEY=

# Exit node only: pin a dedicated egress/alias IP (l3 mode). Usually unnecessary
# inside the container's own netns — leave empty for auto-detection.
EXIT_LOCAL_IP=

# 1 enables verbose packet-level logging (noisy).
DEBUG=0
